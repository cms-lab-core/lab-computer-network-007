name: lab-computer-network-007

topology:
  groups:
    routers:
      kind: linux
      image: quay.io/frrouting/frr:containerlab-10.7.1
    hosts:
      kind: linux
      image: ghcr.io/nicolaka/netshoot:v0.16
  nodes:
    pc1:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
    r1:
      group: routers
      labels:
        flow_icon: router
      binds:
        - configs/r1/daemons:/etc/frr/daemons
        - configs/r1/frr.conf:/etc/frr/frr.conf
      exec:
        - /bin/sh -c "echo admin:admin | chpasswd"
        - sysctl -w net.ipv4.ip_forward=1
    r2:
      group: routers
      labels:
        flow_icon: router
      binds:
        - configs/r2/daemons:/etc/frr/daemons
        - configs/r2/frr.conf:/etc/frr/frr.conf
      exec:
        - /bin/sh -c "echo admin:admin | chpasswd"
        - sysctl -w net.ipv4.ip_forward=1
    pc2:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
  links:
    - endpoints: ["pc1:eth1", "r1:eth1"]
    - endpoints: ["r1:eth2", "r2:eth1"]
    - endpoints: ["r2:eth2", "pc2:eth1"]
